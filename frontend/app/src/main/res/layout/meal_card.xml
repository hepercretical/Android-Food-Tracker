<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Card">
    <TextView android:id="@+id/meal_title" style="@style/Heading" tools:text="Breakfast" />
    <TextView android:id="@+id/meal_calories" style="@style/Body" android:text="@string/meal_calories" android:layout_marginTop="4dp" />
    <TextView android:id="@+id/meal_empty_message" style="@style/Body" android:text="@string/empty_meal" android:textColor="@color/text" android:textSize="16sp" android:layout_marginTop="16dp" />
    <TextView android:id="@+id/meal_empty_detail" style="@style/Body" android:text="@string/empty_detail" android:layout_marginTop="4dp" />
    <LinearLayout
        android:id="@+id/meal_entries"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical" />
    <Button
        android:id="@+id/add_food"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginTop="12dp"
        android:text="@string/add_food"
        android:textAllCaps="false"
        android:textColor="@color/primary" />
</LinearLayout>
