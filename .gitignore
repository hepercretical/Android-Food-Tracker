# Java / Android build outputs and caches (at any project depth)
.gradle/
**/.gradle-cache/
.kotlin/
build/
target/
out/
bin/
*.class
*.dex
*.apk
*.aab
*.ap_

# Machine-specific Android SDK paths and signing configuration
local.properties
keystore.properties
*.jks
*.keystore
*.p12
*.pfx

# Local credentials; keep shareable environment templates
.env
.env.*
!.env.example
!.env.sample
!.env.template
/.aws/

# Generated IDE metadata; shared VS Code tasks/settings remain trackable
.idea/
*.iml
.classpath
.project
.settings/

# Logs, temporary files, and editor backups
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini
desktop.ini

# SQLite runtime sidecars; retain the food database itself
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.db-journal
*.db-wal
*.db-shm

# Do not ignore *.jar: Gradle/Maven wrapper JARs belong in version control.
